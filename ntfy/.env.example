# Public examples only. Set real paths and unique credentials in an ignored .env.
NTFY_BASE_URL=https://ntfy.example.com
NTFY_AUTH_DEFAULT_ACCESS=read-write
NTFY_SMTP_SENDER_USER=operator@example.com
NTFY_KEEPALIVE_INTERVAL=5m
NTFY_ATTACHMENT_EXPIRY_DURATION=24h
NTFY_ENABLE_LOGIN=true
NTFY_SMTP_SENDER_ADDR=smtp.your-domain.de
TZ=Europe/London
NTFY_CACHE_DURATION=24h
NTFY_ATTACHMENT_TOTAL_SIZE_LIMIT=1G
NTFY_AUTH_FILE=/var/lib/ntfy/auth.db
NTFY_WEB_PUSH_FILE=/var/cache/ntfy/webpush.db
NTFY_ENABLE_SIGNUP=true
NTFY_UPSTREAM_BASE_URL=https://ntfy.sh
UPSTREAM_BASE_URL=https://ntfy.sh
NTFY_UPSTREAM_ACCESS_TOKEN=
NTFY_WEB_PUSH_PUBLIC_KEY=
NTFY_WEB_PUSH_PRIVATE_KEY=
NTFY_BEHIND_PROXY=true
UPSTREAM_ACCESS_TOKEN=
NTFY_CACHE_FILE=/var/cache/ntfy/cache.db
NTFY_MANAGER_INTERVAL=5m
NTFY_SMTP_SENDER_FROM=operator@example.com
NTFY_SMTP_SENDER_PASS=CHANGE_ME_generate_a_unique_secret
NTFY_WEB_PUSH_EMAIL_ADDRESS=
NTFY_VISITOR_MESSAGE_DAILY_LIMIT=100
NTFY_VISITOR_ATTACHMENT_DAILY_BANDWIDTH_LIMIT=1G
NTFY_ATTACHMENT_FILE_SIZE_LIMIT=10M
VOLUME_1_NAME=ntfy_volume_1
VOLUME_2_NAME=ntfy_volume_2
BIND_ADDRESS=127.0.0.1
WEB_PORT=8089
