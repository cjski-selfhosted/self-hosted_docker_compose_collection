# Do not start a second proxy on ports already owned by Coolify.
TRAEFIK_CONFIG_FILE=./config/traefik.yml
TRAEFIK_DYNAMIC_DIR=./dynamic
TRAEFIK_ACME_DIR=./acme
PROXY_NETWORK=coolify
HTTP_BIND_ADDRESS=0.0.0.0
HTTPS_BIND_ADDRESS=0.0.0.0
CLOUDFLARE_DNS_API_TOKEN=
DUCKDNS_TOKEN=CHANGE_ME_your_duckdns_token
TRAEFIK_CERTS_DIR=./certs
TUNNEL_HTTP_BIND_ADDRESS=127.0.0.1
TUNNEL_HTTPS_BIND_ADDRESS=127.0.0.1
