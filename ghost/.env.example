# Public examples only. Set real paths and unique credentials in an ignored .env.
MYSQL_ROOT_PASSWORD=CHANGE_ME_generate_a_unique_secret
MYSQL_PASSWORD=CHANGE_ME_generate_a_unique_secret
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
VOLUME_1_NAME=ghost_volume_1
MAIL__TRANSPORT=SMTP
MAIL__OPTIONS__AUTH__USER=ghost
