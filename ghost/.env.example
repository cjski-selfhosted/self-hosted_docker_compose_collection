DATABASE__CONNECTION__HOST=mysql
MAIL__OPTIONS__AUTH__PASS=CHANGE_ME_generate_a_unique_secret
MAIL__OPTIONS__PORT=25
MAIL__OPTIONS__TLS__REJECTUNAUTHORIZED=false
MAIL_OPTIONS_AUTH_PASS=CHANGE_ME_generate_a_unique_secret
VOLUME_2_NAME=ghost_volume_2
