# Public examples only. Set real paths and unique credentials in an ignored .env.
OPENVPN_USER=protonvpn
OPENVPN_EXTRA_ARGS=--tun-mtu 1390 --fragment 1390 --mssfix 1390
OPENVPN_PASSWORD=CHANGE_ME_generate_a_unique_secret
UPDATER_PROTONVPN_PASSWORD=CHANGE_ME_generate_a_unique_secret
VPN_PORT_FORWARDING=on
UPDATER_PROTONVPN_USERNAME=protonvpn
SERVER_COUNTRIES=United Kingdom,Germany,Belgium,Netherlands
VPN_SERVICE_PROVIDER=gluetun
GLUETUN_BIND_1=./data/gluetun-1
BIND_ADDRESS=127.0.0.1
GLUETUN_PORT_49893=49893
GLUETUN_PORT_6881=6881
GLUETUN_PORT_6881_UDP=6881
