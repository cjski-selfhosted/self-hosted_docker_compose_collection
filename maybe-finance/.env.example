# Public examples only. Set real paths and unique credentials in an ignored .env.
POSTGRES_DB=maybe_finance
POSTGRES_PASSWORD=CHANGE_ME_generate_a_unique_secret
POSTGRES_USER=maybe_finance
VOLUME_1_NAME=maybe-finance_volume_1
DB_HOST=postgres
