# Public examples only. Set real paths and unique credentials in an ignored .env.
OPENVPN_USER=CHANGE_ME_provider_openvpn_username
OPENVPN_EXTRA_ARGS=--tun-mtu 1390 --fragment 1390 --mssfix 1390
OPENVPN_PASSWORD=CHANGE_ME_provider_openvpn_password
UPDATER_PROTONVPN_PASSWORD=CHANGE_ME_only_if_using_server_updater
VPN_PORT_FORWARDING=off
UPDATER_PROTONVPN_USERNAME=CHANGE_ME_only_if_using_server_updater
SERVER_COUNTRIES=United Kingdom,Germany,Belgium,Netherlands
VPN_SERVICE_PROVIDER=protonvpn
GLUETUN_BIND_1=./data/gluetun-1
